{
  "name": "twilic",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "format": "prettier --write \"{README.md,CONTRIBUTING.md,SPEC.md,docs/**/*.md,examples/**/*.md,diagrams/**/*.md,versions/**/*.md,conformance/**/*.md,runtimes/README.md,runtimes/*/README.md,runtimes/*/docs/**/*.md,testdata/**/*.md}\"",
    "format:check": "prettier --check \"{README.md,CONTRIBUTING.md,SPEC.md,docs/**/*.md,examples/**/*.md,diagrams/**/*.md,versions/**/*.md,conformance/**/*.md,runtimes/README.md,runtimes/*/README.md,runtimes/*/docs/**/*.md,testdata/**/*.md}\"",
    "lint": "markdownlint-cli2 \"{README.md,CONTRIBUTING.md,SPEC.md,docs/**/*.md,examples/**/*.md,diagrams/**/*.md,versions/**/*.md,conformance/**/*.md,runtimes/README.md,runtimes/*/README.md,runtimes/*/docs/**/*.md,testdata/**/*.md}\"",
    "test:runtime": "bash conformance/run.sh",
    "test:all": "bash conformance/run.sh all",
    "test:fixtures": "bash conformance/run.sh fixtures",
    "generate:fixtures": "bash conformance/generate-fixtures.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "smol-toml": "1.9.0",
    "katex": "0.18.2",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "source-map-js": "1.2.2",
    "cosmiconfig": {
      "js-yaml": "4.3.2"
    }
  }
}
