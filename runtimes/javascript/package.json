{
  "name": "@twilic/core",
  "version": "3.2.0",
  "description": "Node.js and TypeScript implementation of a fast, compact binary wire format for modern data transport.",
  "keywords": [
    "@twilic/core",
    "napi",
    "rust",
    "twilic",
    "typescript",
    "wasm"
  ],
  "homepage": "https://github.com/twilic/twilic/tree/main/runtimes/javascript#readme",
  "bugs": {
    "url": "https://github.com/twilic/twilic/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twilic/twilic.git",
    "directory": "runtimes/javascript"
  },
  "files": [
    "dist",
    "native",
    "wasm/pkg",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js",
      "default": "./dist/advanced.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:napi && bun run build:wasm && bun run build:ts",
    "build:ts": "tsc -p tsconfig.json",
    "build:napi": "cargo build --locked --manifest-path Cargo.toml -p twilic-napi --release && node ./scripts/copy-napi.mjs",
    "build:wasm": "wasm-pack build crates/twilic-wasm --target bundler --out-dir ../../wasm/pkg --out-name twilic_wasm --no-opt -- --locked && rm -f wasm/pkg/.gitignore",
    "verify:pack": "node ./scripts/verify-pack-contents.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src scripts tests",
    "lint:fix": "oxlint --fix src scripts tests",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test --locked --manifest-path Cargo.toml -p twilic-bridge",
    "test:node": "bun run build:napi && bun run build:ts && node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:node:ci": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test": "bun run test:rust && bun run test:node",
    "prepack": "bun run build",
    "release:check": "node ./scripts/verify-tag-version.mjs",
    "clean": "rimraf dist native wasm target",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "ultracite": "7.12.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "smol-toml": "1.9.0",
    "katex": "0.18.2",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2"
  }
}
