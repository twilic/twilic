          data = values.map(&:i64)
          return [select_integer_codec(data), typed_data_i64(data)]
        if kinds.all?(ValueKindU64)
          data = values.map(&:u64)
          return [select_u64_codec(data), typed_data_u64(data)]
        if kinds.all?(ValueKindF64)
          data = values.map(&:f64)
          return [select_float_codec(data), typed_data_f64(data)]
        if kinds.all?(ValueKindBOOL)
          data = values.map(&:bool)
          return [VectorCodecDIRECT_BITPACK, typed_data_bool(data)]
