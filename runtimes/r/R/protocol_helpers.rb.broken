          return select_integer_codec(values.map { |v| v & 0x7FFFFFFFFFFFFFFF })
        return VectorCodecDIRECT_BITPACK if length(values) < 4
        repeated_ratio, avg_run = run_stats_u64(values)
        return VectorCodecRLE if repeated_ratio >= 0.5 && avg_run >= 3.0
        return VectorCodecFOR_BITPACK if bit_width_u64(values.max - values.min) <= 60
        max_width = values.map { |v| bit_width_u64(v) }.max
        return VectorCodecSIMPLE8B if length(values) >= 8 && max_width <= 16
        return VectorCodecDIRECT_BITPACK if max_width < 64
        VectorCodecPLAIN
