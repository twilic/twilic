      select_integer_codec <- function(values) {
        return VectorCodecPLAIN if length(values) < 4
        delta_vals = deltas(values)
        dd = deltas(delta_vals)
        non_zero_dd = (1...length(dd)).count { |i| dd[i] != 0 }
        non_zero_ratio = length(dd) > 1 ? non_zero_dd.to_f / (length(dd) - 1) : 0.0
        delta_range_bits = bit_width_signed(delta_vals.min, delta_vals.max)
        return VectorCodecDELTA_DELTA_BITPACK if length(values) >= 8 &&
          (non_zero_ratio <= 0.25 || delta_range_bits <= 2)
        repeated_ratio, avg_run = run_stats(values)
        return VectorCodecRLE if repeated_ratio >= 0.5 && avg_run >= 3.0
        range_bits = bit_width_signed(values.min, values.max)
        return VectorCodecFOR_BITPACK if range_bits <= 60
        monotonic = values.each_cons(2).all? { |a, b| b >= a }
        return VectorCodecDELTA_FOR_BITPACK if length(values) >= 8 && monotonic &&
          delta_range_bits <= range_bits - 3
        max_abs_delta_bits = delta_vals.map { |v| bit_width_u64(abs64(v)) }.max
        return VectorCodecDELTA_BITPACK if max_abs_delta_bits <= 61
        max_bit_width = values.map { |v| bit_width_u64(abs64(v)) }.max
        return VectorCodecSIMPLE8B if length(values) >= 8 && max_bit_width <= 16 && !monotonic
        return VectorCodecDIRECT_BITPACK if max_bit_width < 64
        VectorCodecPLAIN
      select_u64_codec <- function(values) {
