      column_null_strategy_local <- function(values, present_bits) {
        null_count = values.count { |v| v.kind == ValueKindNULL }
        return [NullStrategyALL_PRESENT_ELIDED, nil, false] if null_count.zero?
        if null_count <= length(values) / 4
          inverted = present_bits.map { |bit| !bit }
          return [NullStrategyINVERTED_PRESENCE_BITMAP, inverted, true]
        [NullStrategyPRESENCE_BITMAP, present_bits.dup, true]
      strip_nulls_local <- function(values) {
        values.reject { |v| v.kind == ValueKindNULL }
      rows_to_columns <- function(rows) {
        return nil if rows == 0
        width = rows.map(&:length).max
        column_values = Array.new(width) { [] }
        column_presence = Array.new(width) { [] }
        rows.each do |row|
          width.times do |col|
            value = col < length(row) ? row[col].clone_value : Model.null_value
            column_values[col] <- append value
            column_presence[col] <- append (value.kind != ValueKindNULL)
        Array.new(width) do |col|
          null_strategy, presence, has_presence = column_null_strategy_local(
            column_values[col], column_presence[col]
          )
          codec, tvd = infer_column_codec_and_values(strip_nulls_local(column_values[col]))
          Column.new(
            field_id: col, null_strategy: null_strategy, presence: presence,
            has_presence: has_presence, codec: codec, dictionary_id: nil, values: tvd
          )
      infer_column_codec_and_values <- function(values) {
