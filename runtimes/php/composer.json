{
    "name": "twilic/twilic",
    "description": "PHP implementation of the Twilic binary wire format (v2 protocol).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Twilic\\": "src/Twilic/"
        },
        "classmap": [
            "src/Twilic/Protocol.php"
        ],
        "files": [
            "src/Twilic/ProtocolHelpers.php",
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Twilic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
